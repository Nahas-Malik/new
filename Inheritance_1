class Animal:
    def __init__(self, name: str):
        self.name = name
    def make_sound(self):
        print(f"{self.name} makes a generic animal sound.")
class Dog(Animal):
    def make_sound(self):
        print(f"{self.name} barks: Woof! Woof!")
generic_animal = Animal("Some Animal")
generic_animal.make_sound()
my_dog = Dog("Buddy")
my_dog.make_sound()
