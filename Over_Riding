class Vehicle:
    def __init__(self, brand):
        self.brand=brand
    def start_engine(self):
        return f"The {self.brand} vehicle engine starts with a generic roar."
class Bike(Vehicle):
    def start_engine(self):
        return f"The {self.brand} bike engine revs cleanly: Vroom Vroom!"
if __name__=="__main__":
    garage=[
        Vehicle("Generic"),
        Bike("Yamaha"),
        Bike("Ducati")
    ]
    for vehicle in garage:
        print(vehicle.start_engine())
