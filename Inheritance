class Parent:
    def __init__(self,name):
        self.name=name
    def display(self):
        print(f"{self.name}")
class Child(Parent):
    def __init__(self,name,age):
        super().__init__(name)
        self.age=age
    def display(self):
        super().display()
        print(f"{self.name}---{self.age}")
obj=Child("sneha",45)
obj.display()
